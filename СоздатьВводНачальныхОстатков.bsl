////////////////////////////////////////////////////////////////////////////////
// Обработка: ЗагрузкаНоменклатурыИз_10_3
// Модуль формы
//
// Процедуры для кнопки "СоздатьВВодНачальныхОстатков"
// Создаёт документ "ВводОстатковТоваров" (УТ 11.5.22.149)
// на основании данных табличной части обработки.
//
// Реквизиты формы:
//   Организация  (СправочникСсылка.Организации)
//   Склад        (СправочникСсылка.Склады)
//
// Табличная часть объекта "ТабличныйДокумент":
//   НомерСтроки, Артикул, ШтрихКод,
//   Наименование  (СправочникСсылка.Номенклатура),
//   Характеристика (Строка), ВидНоменклатуры (Строка),
//   ЦенаЗакупочная (Строка), Кол_во,
//   GUIDБазеИсточнике (Строка), GuidНоменклатурыВБазеИсточнике (Строка)
////////////////////////////////////////////////////////////////////////////////

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьВВодНачальныхОстатков(Команда)

	ОчиститьСообщения();

	// --- Валидация заполнения реквизитов ---

	ЕстьОшибки = Ложь;

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Не заполнено поле ""Организация""!";
		СообщениеПользователю.Поле  = "Организация";
		СообщениеПользователю.Сообщить();
		ЕстьОшибки = Истина;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(Склад) Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Не заполнено поле ""Склад""!";
		СообщениеПользователю.Поле  = "Склад";
		СообщениеПользователю.Сообщить();
		ЕстьОшибки = Истина;
	КонецЕсли;

	Если Объект.ТабличныйДокумент.Количество() = 0 Тогда
		СообщениеПользователю = Новый СообщениеПользователю;
		СообщениеПользователю.Текст = "Табличная часть пуста! Сначала загрузите данные из CSV.";
		СообщениеПользователю.Сообщить();
		ЕстьОшибки = Истина;
	КонецЕсли;

	Если ЕстьОшибки Тогда
		Возврат;
	КонецЕсли;

	// --- Создание документа на сервере ---

	Результат = СоздатьВВодНачальныхОстатковНаСервере();

	Если Результат.Успешно Тогда

		ПоказатьОповещениеПользователя(
			"Документ создан",
			ПолучитьНавигационнуюСсылку(Результат.Ссылка),
			"Ввод остатков товаров: " + Строка(Результат.Ссылка),
			БиблиотекаКартинок.Информация32);

		// Открыть созданный документ для проверки
		ПараметрыФормы = Новый Структура("Ключ", Результат.Ссылка);
		ОткрытьФорму("Документ.ВводОстатковТоваров.ФормаОбъекта", ПараметрыФормы);

	Иначе
		ПоказатьПредупреждение(, "Ошибка при создании документа:" + Символы.ПС + Результат.ОписаниеОшибки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СоздатьВВодНачальныхОстатковНаСервере()

	Результат = Новый Структура("Успешно, Ссылка, ОписаниеОшибки", Ложь, Неопределено, "");

	Попытка

		// ============================================================
		// 1. СОЗДАНИЕ ДОКУМЕНТА
		// ============================================================

		ДокументОбъект = Документы.ВводОстатковТоваров.СоздатьДокумент();

		// ============================================================
		// 2. ЗАПОЛНЕНИЕ ШАПКИ ДОКУМЕНТА
		// ============================================================

		ДокументОбъект.Дата         = ТекущаяДата();
		ДокументОбъект.Организация  = Организация;
		ДокументОбъект.Склад        = Склад;

		// Хозяйственная операция: "Ввод остатков собственных товаров"
		ДокументОбъект.ХозяйственнаяОперация = Перечисления.ХозяйственныеОперации.ВводОстатковСобственныхТоваров;

		// Настройки отражения в учёте
		ДокументОбъект.ОтражатьВОперативномУчете = Истина;
		ДокументОбъект.ОтражатьСебестоимость      = Истина;
		ДокументОбъект.ОтражатьВБУиНУ            = Ложь;
		ДокументОбъект.ОтражатьВУУ               = Ложь;
		ДокументОбъект.ОтражатьНДД               = Ложь;

		// НДС
		ДокументОбъект.ЦенаВключаетНДС   = Истина;
		ДокументОбъект.НалогообложениеНДС = Перечисления.ТипыНалогообложенияНДС.ПродажаОблагаетсяНДС;

		// Валюта — RUB (код 643)
		ДокументОбъект.Валюта = Справочники.Валюты.НайтиПоКоду("643");
		Если НЕ ЗначениеЗаполнено(ДокументОбъект.Валюта) Тогда
			ДокументОбъект.Валюта = Справочники.Валюты.НайтиПоНаименованию("руб.");
		КонецЕсли;

		// Ответственный / Автор
		ДокументОбъект.Ответственный = Пользователи.ТекущийПользователь();
		ДокументОбъект.Автор         = Пользователи.ТекущийПользователь();

		// Комментарий
		ДокументОбъект.Комментарий = "Создан обработкой загрузки номенклатуры из УТ 10.3";

		// Партия — ДокументСсылка.ПервичныйДокумент
		// "Приобретение у поставщика 1 от 01.01.2026 13:17:00"
		ПартияСсылка = Документы.ПервичныйДокумент.НайтиПоНомеру("1", '20260101131700');
		Если ЗначениеЗаполнено(ПартияСсылка) Тогда
			ДокументОбъект.Партия = ПартияСсылка;
		КонецЕсли;

		// ============================================================
		// 3. ЗАПОЛНЕНИЕ ТАБЛИЧНОЙ ЧАСТИ "ТОВАРЫ"
		// ============================================================

		// Ставка НДС 5% (Льготное налогообложение НДС на УСН)
		СтавкаНДС    = Перечисления.СтавкиНДС.НДС5;
		СтавкаПроцент = 5;

		Для Каждого СтрокаТЧ Из Объект.ТабличныйДокумент Цикл

			// Пропускаем строки без привязанной номенклатуры
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Наименование) Тогда
				Продолжить;
			КонецЕсли;

			НоваяСтрока = ДокументОбъект.Товары.Добавить();

			// --- Номенклатура (уже ссылка СправочникСсылка.Номенклатура) ---
			НоваяСтрока.Номенклатура = СтрокаТЧ.Наименование;

			// --- Характеристика ---
			Если ЗначениеЗаполнено(СтрокаТЧ.Характеристика) Тогда
				ХарактеристикаСсылка = Справочники.ХарактеристикиНоменклатуры.НайтиПоНаименованию(
					СокрЛП(СтрокаТЧ.Характеристика),
					,
					,
					СтрокаТЧ.Наименование);
				Если ЗначениеЗаполнено(ХарактеристикаСсылка) Тогда
					НоваяСтрока.Характеристика = ХарактеристикаСсылка;
				КонецЕсли;
			КонецЕсли;

			// --- Количество ---
			Количество = 0;
			Попытка
				Количество = Число(СтрокаТЧ.Кол_во);
			Исключение
				Количество = 1;
			КонецПопытки;

			НоваяСтрока.Количество        = Количество;
			НоваяСтрока.КоличествоУпаковок = Количество;

			// --- Цена (из строки ЦенаЗакупочная) ---
			Цена = 0;
			Попытка
				ЦенаСтрока = СокрЛП(Строка(СтрокаТЧ.ЦенаЗакупочная));
				ЦенаСтрока = СтрЗаменить(ЦенаСтрока, " ", "");
				ЦенаСтрока = СтрЗаменить(ЦенаСтрока, Символы.НПП, "");
				Цена = Число(ЦенаСтрока);
			Исключение
				Цена = 0;
			КонецПопытки;

			Если Цена = 0 Тогда
				Цена = 1;
			КонецЕсли;

			НоваяСтрока.Цена = Цена;

			// --- Сумма ---
			Сумма = Цена * Количество;
			НоваяСтрока.Сумма = Сумма;

			// --- НДС (цена включает НДС, ставка 5%) ---
			НоваяСтрока.СтавкаНДС  = СтавкаНДС;
			СуммаНДС = Окр(Сумма * СтавкаПроцент / (100 + СтавкаПроцент), 2);
			НоваяСтрока.СуммаНДС    = СуммаНДС;
			НоваяСтрока.СуммаБезНДС = Сумма - СуммаНДС;

			// --- Суммы регл. учёта (валюта RUB = валюта регл. учёта) ---
			НоваяСтрока.СуммаРегл    = Сумма;
			НоваяСтрока.НДСРегл      = СуммаНДС;

			// --- Вид запасов: собственный товар (справочник) ---
			НоваяСтрока.ВидЗапасов = Справочники.ВидыЗапасов.НайтиПоНаименованию("Собственный товар");

		КонецЦикла;

		// ============================================================
		// 4. ЗАПИСЬ ДОКУМЕНТА (без проведения — для проверки пользователем)
		// ============================================================

		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);

		Результат.Успешно = Истина;
		Результат.Ссылка  = ДокументОбъект.Ссылка;

	Исключение

		Результат.Успешно        = Ложь;
		Результат.ОписаниеОшибки = ОписаниеОшибки();

	КонецПопытки;

	Возврат Результат;

КонецФункции

#КонецОбласти
